#!/bin/bash
# /usr/local/bin/phantomixos-agent
# Thin wrapper around phantomagent that auto-starts the inference server
# if it is not already running, and selects the right model.

set -uo pipefail

MODEL_DIR="/usr/local/share/phantomixos/models"
PORT="${PHANTOMIXOS_LLM_PORT:-8080}"
PID_FILE="/run/phantomixos/llama.pid"

log() { echo "[phantomixos-agent] $*"; }

# ---- Ensure inference server is up ----
ensure_server() {
    if curl -sf "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
        log "Inference server already running on port $PORT"
        return 0
    fi

    log "Inference server not running; starting it..."
    if ! command -v phantomixos-ai-autostart >/dev/null 2>&1; then
        log "ERROR: phantomixos-ai-autostart not found in PATH"
        return 1
    fi
    phantomixos-ai-autostart
}

# ---- Route subcommands ----
if [ "${1:-}" = "run" ]; then
    ensure_server || exit 1
    exec phantomagent "$@"
elif [ "${1:-}" = "server" ]; then
    exec phantomixos-ai-autostart
else
    # Just print help from phantomagent, but show server status first
    ensure_server || log "Warning: inference server unavailable"
    exec phantomagent "$@"
fi